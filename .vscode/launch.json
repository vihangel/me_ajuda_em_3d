{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (local)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://localhost:3000/api/3d"]
    },
    {
      "name": "Debug (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://localhost:3000/api/3d",
        "-d",
        "chrome"
      ]
    },
    {
      "name": "Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=https://oicoach-production.up.railway.app/api/3d"
      ]
    },
    {
      "name": "Profile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define=API_BASE_URL=http://localhost:3000/api/3d"]
    }
  ]
}
